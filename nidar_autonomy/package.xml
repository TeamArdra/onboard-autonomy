<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nidar_autonomy</name>
  <version>0.0.1</version>
  <description>
    Onboard autonomy nodes for NIDAR AirMouse. Phase 0: command
    handling, mission state reporting, and heartbeat only. No SLAM,
    detection, or flight control yet -- see this repo's CLAUDE.md.
  </description>
  <maintainer email="raj.tibarewala@gmail.com">TeamArdra</maintainer>
  <license>TODO</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>mavros_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
